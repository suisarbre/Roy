{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sim.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/sim/harness/cli.ts",
    "src/sim/npc/demo.ts",
    "src/sim/harness/sceneFrequency.ts",
    "src/sim/input/regressionCli.ts",
    "src/game/memoryExtractionCheck.ts",
    "src/game/threadEngineCheck.ts",
    "src/game/npcCheckInCheck.ts",
    "src/sim/marriage/cli.ts",
    "src/sim/marriage/calibrate.ts",
    "src/sim/career/cli.ts",
    "src/sim/career/calibrate.ts",
    "src/sim/world/calibrate.ts",
    "src/sim/world/evalWorker.ts",
    "src/sim/world/cli.ts"
  ]
}
